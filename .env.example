DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id-here
# Optional: set this to a server ID while testing so slash commands register instantly.
# Leave blank to register commands globally (takes up to 1 hour to propagate).
GUILD_ID=

# Optional: ID channel (forum/text) tempat thread rekap loot dibuat.
# Kalau dikosongin, thread akan dibuat di channel yang sama dengan party.
LOOT_THREAD_CHANNEL_ID=
